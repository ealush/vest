{
  "name": "n4s",
  "version": "5.10.10",
  "description": "typed schema validation version of enforce",
  "license": "MIT",
  "author": "ealush",
  "private": true,
  "main": "./dist/n4s.cjs",
  "module": "./dist/n4s.mjs",
  "unpkg": "./dist/n4s.mjs",
  "jsdelivr": "./dist/n4s.mjs",
  "types": "./types/n4s.d.cts",
  "repository": {
    "type": "git",
    "url": "https://github.com/ealush/vest.git",
    "directory": "packages/n4s"
  },
  "bugs": {
    "url": "https://github.com/ealush/vest.git/issues"
  },
  "dependencies": {
    "context": "^3.0.33",
    "vest-utils": "^1.3.3"
  },
  "devDependencies": {
    "@types/validator": "^13.11.10",
    "validator": "13.9.0"
  },
  "vxAllowResolve": [
    "validator"
  ],
  "exports": {
    "./exports/date": {
      "types": "./types/exports/date.d.cts",
      "import": "./dist/exports/date.mjs",
      "require": "./dist/exports/date.cjs"
    },
    "./exports/email": {
      "types": "./types/exports/email.d.cts",
      "import": "./dist/exports/email.mjs",
      "require": "./dist/exports/email.cjs"
    },
    "./exports/isURL": {
      "types": "./types/exports/isURL.d.cts",
      "import": "./dist/exports/isURL.mjs",
      "require": "./dist/exports/isURL.cjs"
    },
    "./n4s": {
      "types": "./types/n4s.d.cts",
      "import": "./dist/n4s.mjs",
      "require": "./dist/n4s.cjs"
    },
    "./*": {
      "types": "./types/n4s.d.cts",
      "default": "./*"
    },
    ".": {
      "types": "./types/n4s.d.cts",
      "import": "./dist/n4s.mjs",
      "require": "./dist/n4s.cjs"
    },
    "./package.json": "./package.json",
    "./date": {
      "types": "./types/n4s.d.cts",
      "import": "./dist/exports/date.mjs",
      "require": "./dist/exports/date.cjs"
    },
    "./email": {
      "types": "./types/n4s.d.cts",
      "import": "./dist/exports/email.mjs",
      "require": "./dist/exports/email.cjs"
    },
    "./isURL": {
      "types": "./types/n4s.d.cts",
      "import": "./dist/exports/isURL.mjs",
      "require": "./dist/exports/isURL.cjs"
    },
    "./n4s.d.ts": "./types/n4s.d.ts",
    "./types/*": "./types/*",
    "./dist/*": "./dist/*"
  }
}
