{
  "name": "n4s",
  "version": "5.10.10",
  "description": "typed schema validation version of enforce",
  "license": "MIT",
  "author": "ealush",
  "private": true,
  "main": "./dist/n4s.cjs",
  "module": "./dist/n4s.mjs",
  "unpkg": "./dist/n4s.mjs",
  "jsdelivr": "./dist/n4s.mjs",
  "types": "./types/n4s.d.cts",
  "repository": {
    "type": "git",
    "url": "https://github.com/ealush/vest.git",
    "directory": "packages/n4s"
  },
  "bugs": {
    "url": "https://github.com/ealush/vest.git/issues"
  },
  "dependencies": {
    "context": "^3.0.33",
    "vest-utils": "^1.3.3"
  },
  "devDependencies": {
    "@types/validator": "^13.11.10",
    "validator": "13.9.0"
  },
  "vxAllowResolve": [
    "validator"
  ],
  "exports": {
    "./exports/date": {
      "import": "./dist/exports/date.mjs",
      "require": "./dist/exports/date.cjs",
      "types": "./types/exports/date.d.cts"
    },
    "./exports/email": {
      "import": "./dist/exports/email.mjs",
      "require": "./dist/exports/email.cjs",
      "types": "./types/exports/email.d.cts"
    },
    "./exports/isURL": {
      "import": "./dist/exports/isURL.mjs",
      "require": "./dist/exports/isURL.cjs",
      "types": "./types/exports/isURL.d.cts"
    },
    "./n4s": {
      "import": "./dist/n4s.mjs",
      "require": "./dist/n4s.cjs",
      "types": "./types/n4s.d.cts"
    },
    "./*": {
      "default": "./*",
      "types": "./types/n4s.d.cts"
    },
    ".": {
      "import": "./dist/n4s.mjs",
      "require": "./dist/n4s.cjs",
      "types": "./types/n4s.d.cts"
    },
    "./package.json": "./package.json",
    "./date": {
      "import": "./dist/exports/date.mjs",
      "require": "./dist/exports/date.cjs",
      "types": "./types/n4s.d.cts"
    },
    "./email": {
      "import": "./dist/exports/email.mjs",
      "require": "./dist/exports/email.cjs",
      "types": "./types/n4s.d.cts"
    },
    "./isURL": {
      "import": "./dist/exports/isURL.mjs",
      "require": "./dist/exports/isURL.cjs",
      "types": "./types/n4s.d.cts"
    },
    "./n4s.d.ts": "./types/n4s.d.ts",
    "./types/*": "./types/*",
    "./dist/*": "./dist/*"
  },
  "publishConfig": {
    "exports": {
      "./exports/date": {
        "import": "./dist/exports/date.mjs",
        "require": "./dist/exports/date.cjs",
        "types": "./types/exports/date.d.cts"
      },
      "./exports/email": {
        "import": "./dist/exports/email.mjs",
        "require": "./dist/exports/email.cjs",
        "types": "./types/exports/email.d.cts"
      },
      "./exports/isURL": {
        "import": "./dist/exports/isURL.mjs",
        "require": "./dist/exports/isURL.cjs",
        "types": "./types/exports/isURL.d.cts"
      },
      "./n4s": {
        "import": "./dist/n4s.mjs",
        "require": "./dist/n4s.cjs",
        "types": "./types/n4s.d.cts"
      },
      "./*": {
        "default": "./*",
        "types": "./types/n4s.d.cts"
      },
      ".": {
        "import": "./dist/n4s.mjs",
        "require": "./dist/n4s.cjs",
        "types": "./types/n4s.d.cts"
      },
      "./package.json": "./package.json",
      "./n4s.d.ts": {
        "default": "./types/n4s.d.ts",
        "types": "./types/n4s.d.cts"
      },
      "./types/*": {
        "default": "./types/*",
        "types": "./types/n4s.d.cts"
      },
      "./dist/*": {
        "default": "./dist/*",
        "types": "./types/n4s.d.cts"
      }
    }
  }
}
