{
  "name": "vest",
  "version": "5.4.6",
  "description": "Declarative Form Validations Framework",
  "license": "MIT",
  "author": "ealush",
  "main": "./dist/vest.cjs",
  "module": "./dist/vest.mjs",
  "unpkg": "./dist/vest.mjs",
  "jsdelivr": "./dist/vest.mjs",
  "types": "./types/vest.d.cts",
  "keywords": [
    "Form validation",
    "Unit testing",
    "Framework-agnostic",
    "Validation",
    "Declarative",
    "Asynchronous validations",
    "Async validations",
    "Testing",
    "Data validation",
    "Form validation",
    "React Validation",
    "Angular Validation",
    "Vue Validation",
    "Svelte Validation",
    "nodejs Validation",
    "enforce"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ealush/vest.git",
    "directory": "packages/vest"
  },
  "bugs": {
    "url": "https://github.com/ealush/vest.git/issues"
  },
  "dependencies": {
    "context": "^3.0.33",
    "n4s": "^5.0.28",
    "vast": "^1.0.42",
    "vest-utils": "^1.3.3",
    "vestjs-runtime": "^1.5.1"
  },
  "exports": {
    "./exports/classnames": {
      "import": "./dist/exports/classnames.mjs",
      "require": "./dist/exports/classnames.cjs",
      "types": "./types/exports/classnames.d.cts"
    },
    "./exports/debounce": {
      "import": "./dist/exports/debounce.mjs",
      "require": "./dist/exports/debounce.cjs",
      "types": "./types/exports/debounce.d.cts"
    },
    "./exports/enforce@date": {
      "import": "./dist/exports/enforce@date.mjs",
      "require": "./dist/exports/enforce@date.cjs",
      "types": "./types/exports/enforce@date.d.cts"
    },
    "./exports/enforce@email": {
      "import": "./dist/exports/enforce@email.mjs",
      "require": "./dist/exports/enforce@email.cjs",
      "types": "./types/exports/enforce@email.d.cts"
    },
    "./exports/enforce@isURL": {
      "import": "./dist/exports/enforce@isURL.mjs",
      "require": "./dist/exports/enforce@isURL.cjs",
      "types": "./types/exports/enforce@isURL.d.cts"
    },
    "./exports/memo": {
      "import": "./dist/exports/memo.mjs",
      "require": "./dist/exports/memo.cjs",
      "types": "./types/exports/memo.d.cts"
    },
    "./exports/parser": {
      "import": "./dist/exports/parser.mjs",
      "require": "./dist/exports/parser.cjs",
      "types": "./types/exports/parser.d.cts"
    },
    "./exports/SuiteSerializer": {
      "import": "./dist/exports/SuiteSerializer.mjs",
      "require": "./dist/exports/SuiteSerializer.cjs",
      "types": "./types/exports/SuiteSerializer.d.cts"
    },
    "./vest": {
      "import": "./dist/vest.mjs",
      "require": "./dist/vest.cjs",
      "types": "./types/vest.d.cts"
    },
    "./*": {
      "default": "./*",
      "types": "./types/vest.d.cts"
    },
    ".": {
      "import": "./dist/vest.mjs",
      "require": "./dist/vest.cjs",
      "types": "./types/vest.d.cts"
    },
    "./package.json": "./package.json",
    "./classnames": {
      "import": "./dist/exports/classnames.mjs",
      "require": "./dist/exports/classnames.cjs",
      "types": "./types/vest.d.cts"
    },
    "./debounce": {
      "import": "./dist/exports/debounce.mjs",
      "require": "./dist/exports/debounce.cjs",
      "types": "./types/vest.d.cts"
    },
    "./enforce@date": {
      "import": "./dist/exports/enforce@date.mjs",
      "require": "./dist/exports/enforce@date.cjs",
      "types": "./types/vest.d.cts"
    },
    "./enforce@email": {
      "import": "./dist/exports/enforce@email.mjs",
      "require": "./dist/exports/enforce@email.cjs",
      "types": "./types/vest.d.cts"
    },
    "./enforce@isURL": {
      "import": "./dist/exports/enforce@isURL.mjs",
      "require": "./dist/exports/enforce@isURL.cjs",
      "types": "./types/vest.d.cts"
    },
    "./memo": {
      "import": "./dist/exports/memo.mjs",
      "require": "./dist/exports/memo.cjs",
      "types": "./types/vest.d.cts"
    },
    "./parser": {
      "import": "./dist/exports/parser.mjs",
      "require": "./dist/exports/parser.cjs",
      "types": "./types/vest.d.cts"
    },
    "./SuiteSerializer": {
      "import": "./dist/exports/SuiteSerializer.mjs",
      "require": "./dist/exports/SuiteSerializer.cjs",
      "types": "./types/vest.d.cts"
    },
    "./vest.d.ts": "./types/vest.d.ts",
    "./types/*": "./types/*",
    "./dist/*": "./dist/*"
  }
}
