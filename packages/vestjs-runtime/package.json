{
  "name": "vestjs-runtime",
  "version": "1.5.1",
  "description": "Internal runtime module used by Vest",
  "license": "MIT",
  "author": "ealush",
  "main": "./dist/vestjs-runtime.cjs",
  "module": "./dist/vestjs-runtime.mjs",
  "unpkg": "./dist/vestjs-runtime.mjs",
  "jsdelivr": "./dist/vestjs-runtime.mjs",
  "types": "./types/vestjs-runtime.d.cts",
  "repository": {
    "type": "git",
    "url": "https://github.com/ealush/vest.git",
    "directory": "packages/vestjs-runtime"
  },
  "bugs": {
    "url": "https://github.com/ealush/vest.git/issues"
  },
  "dependencies": {
    "context": "^3.0.33",
    "vest-utils": "^1.3.3"
  },
  "exports": {
    "./exports/IsolateSerializer": {
      "import": "./dist/exports/IsolateSerializer.mjs",
      "require": "./dist/exports/IsolateSerializer.cjs"
    },
    "./exports/test-utils": {
      "import": "./dist/exports/test-utils.mjs",
      "require": "./dist/exports/test-utils.cjs"
    },
    "./vestjs-runtime": {
      "import": "./dist/vestjs-runtime.mjs",
      "require": "./dist/vestjs-runtime.cjs"
    },
    "./*": "./*",
    ".": {
      "import": "./dist/vestjs-runtime.mjs",
      "require": "./dist/vestjs-runtime.cjs"
    },
    "./package.json": "./package.json",
    "./IsolateSerializer": {
      "import": "./dist/exports/IsolateSerializer.mjs",
      "require": "./dist/exports/IsolateSerializer.cjs"
    },
    "./test-utils": {
      "import": "./dist/exports/test-utils.mjs",
      "require": "./dist/exports/test-utils.cjs"
    }
  },
  "publishConfig": {
    "exports": {
      "./exports/IsolateSerializer": {
        "import": "./dist/exports/IsolateSerializer.mjs",
        "require": "./dist/exports/IsolateSerializer.cjs",
        "types": "./types/exports/IsolateSerializer.d.cts"
      },
      "./exports/test-utils": {
        "import": "./dist/exports/test-utils.mjs",
        "require": "./dist/exports/test-utils.cjs",
        "types": "./types/exports/test-utils.d.cts"
      },
      "./vestjs-runtime": {
        "import": "./dist/vestjs-runtime.mjs",
        "require": "./dist/vestjs-runtime.cjs",
        "types": "./types/vestjs-runtime.d.cts"
      },
      "./*": "./*",
      ".": {
        "import": "./dist/vestjs-runtime.mjs",
        "require": "./dist/vestjs-runtime.cjs",
        "types": "./types/vestjs-runtime.d.cts"
      },
      "./package.json": "./package.json"
    }
  }
}
