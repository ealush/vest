{
  "name": "vestjs-runtime",
  "version": "1.5.1",
  "description": "Internal runtime module used by Vest",
  "license": "MIT",
  "author": "ealush",
  "main": "./dist/vestjs-runtime.cjs",
  "module": "./dist/vestjs-runtime.mjs",
  "unpkg": "./dist/vestjs-runtime.mjs",
  "jsdelivr": "./dist/vestjs-runtime.mjs",
  "types": "./types/vestjs-runtime.d.cts",
  "repository": {
    "type": "git",
    "url": "https://github.com/ealush/vest.git",
    "directory": "packages/vestjs-runtime"
  },
  "bugs": {
    "url": "https://github.com/ealush/vest.git/issues"
  },
  "dependencies": {
    "context": "^3.0.33",
    "vest-utils": "^1.3.3"
  },
  "exports": {
    "./exports/IsolateSerializer": {
      "types": "./types/exports/IsolateSerializer.d.cts",
      "import": "./dist/exports/IsolateSerializer.mjs",
      "require": "./dist/exports/IsolateSerializer.cjs"
    },
    "./exports/test-utils": {
      "types": "./types/exports/test-utils.d.cts",
      "import": "./dist/exports/test-utils.mjs",
      "require": "./dist/exports/test-utils.cjs"
    },
    "./vestjs-runtime": {
      "types": "./types/vestjs-runtime.d.cts",
      "import": "./dist/vestjs-runtime.mjs",
      "require": "./dist/vestjs-runtime.cjs"
    },
    "./*": {
      "types": "./types/vestjs-runtime.d.cts",
      "default": "./*"
    },
    ".": {
      "types": "./types/vestjs-runtime.d.cts",
      "import": "./dist/vestjs-runtime.mjs",
      "require": "./dist/vestjs-runtime.cjs"
    },
    "./package.json": "./package.json",
    "./IsolateSerializer": {
      "types": "./types/vestjs-runtime.d.cts",
      "import": "./dist/exports/IsolateSerializer.mjs",
      "require": "./dist/exports/IsolateSerializer.cjs"
    },
    "./test-utils": {
      "types": "./types/vestjs-runtime.d.cts",
      "import": "./dist/exports/test-utils.mjs",
      "require": "./dist/exports/test-utils.cjs"
    },
    "./vestjs-runtime.d.ts": "./types/vestjs-runtime.d.ts",
    "./types/*": "./types/*",
    "./dist/*": "./dist/*"
  },
  "publishConfig": {
    "exports": {
      "./exports/IsolateSerializer": {
        "types": "./types/exports/IsolateSerializer.d.cts",
        "import": "./dist/exports/IsolateSerializer.mjs",
        "require": "./dist/exports/IsolateSerializer.cjs"
      },
      "./exports/test-utils": {
        "types": "./types/exports/test-utils.d.cts",
        "import": "./dist/exports/test-utils.mjs",
        "require": "./dist/exports/test-utils.cjs"
      },
      "./vestjs-runtime": {
        "types": "./types/vestjs-runtime.d.cts",
        "import": "./dist/vestjs-runtime.mjs",
        "require": "./dist/vestjs-runtime.cjs"
      },
      "./*": {
        "types": "./types/vestjs-runtime.d.cts",
        "default": "./*"
      },
      ".": {
        "types": "./types/vestjs-runtime.d.cts",
        "import": "./dist/vestjs-runtime.mjs",
        "require": "./dist/vestjs-runtime.cjs"
      },
      "./package.json": "./package.json",
      "./Isolate-DDQqod3l": {
        "types": "./types/Isolate-DDQqod3l.d.mts",
        "default": "./types/Isolate-DDQqod3l.d.mts"
      },
      "./Isolate-DI-lLdpw": {
        "types": "./types/Isolate-DI-lLdpw.d.cts",
        "default": "./types/Isolate-DI-lLdpw.d.cts"
      },
      "./IsolateSerializer-CrpXnofj": {
        "types": "./types/IsolateSerializer-CrpXnofj.d.mts",
        "default": "./types/IsolateSerializer-CrpXnofj.d.mts"
      },
      "./IsolateSerializer-Dqh6viJr": {
        "types": "./types/IsolateSerializer-Dqh6viJr.d.cts",
        "default": "./types/IsolateSerializer-Dqh6viJr.d.cts"
      },
      "./vestjs-runtime.d.ts": {
        "types": "./types/vestjs-runtime.d.cts",
        "default": "./types/vestjs-runtime.d.ts"
      },
      "./types/*": {
        "types": "./types/vestjs-runtime.d.cts",
        "default": "./types/*"
      },
      "./dist/*": {
        "types": "./types/vestjs-runtime.d.cts",
        "default": "./dist/*"
      }
    }
  }
}
